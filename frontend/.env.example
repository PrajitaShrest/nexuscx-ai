# Copy this file to .env.local and fill in the values from Supabase -> Connect.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Online only: the public address of the app, used in password-reset and invite emails.
# Leave empty on your laptop. On Vercel set it to e.g. https://nexuscx-ai.vercel.app
NEXT_PUBLIC_SITE_URL=
